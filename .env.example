# ─── Contact Form ────────────────────────────────────────────────────────────
# Formspree endpoint for the Contact page form.
# 1. Sign up at https://formspree.io (free)
# 2. Create a new form → copy the endpoint URL
# 3. Paste it here — submissions will be emailed to your Formspree account email
VITE_CONTACT_ENDPOINT=https://formspree.io/f/YOUR_CONTACT_FORM_ID

# ─── Career Applications ──────────────────────────────────────────────────────
# Separate Formspree endpoint for the Careers page application form.
# Create a second form on Formspree for career applications.
VITE_CAREERS_ENDPOINT=https://formspree.io/f/YOUR_CAREERS_FORM_ID

# ─── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (optional)
# e.g. G-XXXXXXXXXX
VITE_ANALYTICS_ID=

# ─── Site URL ─────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://swaptechsolutions.in
